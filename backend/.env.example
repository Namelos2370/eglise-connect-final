# ============================================================
# ÉGLISE CONNECT — Variables d'environnement (Backend)
# Copiez ce fichier en ".env" et remplissez les valeurs
# NE JAMAIS COMMITER LE FICHIER .env RÉEL
# ============================================================

# --- SERVEUR ---
PORT=3002
CLIENT_URL=https://eglise-connect.com

# --- BASE DE DONNÉES ---
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster.mongodb.net/eglise-connect

# --- AUTHENTIFICATION ---
JWT_SECRET=changez_cette_valeur_par_une_chaine_aleatoire_longue

# --- EMAIL (Gmail) ---
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_gmail

# --- CLOUDINARY (Stockage fichiers) ---
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# --- STRIPE (Paiements carte) ---
STRIPE_SECRET_KEY=votre_cle_secrete_stripe

# --- CAMPAY (Mobile Money) ---
CAMPAY_TOKEN=votre_token_campay
